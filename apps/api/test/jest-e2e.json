{
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "testTimeout": 30000,
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "diagnostics": {
          "exclude": [
            "**/test/specs/auth/regression-register.e2e-spec.ts",
            "**/test/specs/auth/regression-login.e2e-spec.ts",
            "**/test/specs/auth/regression-session.e2e-spec.ts"
          ]
        }
      }
    ]
  },
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "setupFilesAfterEnv": [
    "<rootDir>/test/fixture/isolation.ts"
  ]
}
